      "preenche": [
        {"tipo": "campo", "nome": "queixa_principal"},
        {"tipo": "campo", "nome": "relato_original"},
        {"tipo": "sinal", "nome": "qualquer sinal citado no relato"}
      ]
    },
    {
      "id": "P02",
      "texto": "Há quanto tempo isso começou?",
      "tipo": "numero_unidade",
      "unidades": ["minutos", "horas", "dias", "semanas", "meses", "anos"],
      "preenche": [{"tipo": "campo", "nome": "duracao"}]
    },
    {
      "id": "P03",
      "texto": "Começou de repente?",
      "tipo": "sim_nao",
      "preenche": [{"tipo": "sinal", "nome": "inicio_subito"}]
    },
    {
      "id": "P04",
      "texto": "Está com dor? De 0 a 10, quanto?",
